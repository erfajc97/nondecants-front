---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentConfirmation from '@/app/features/order/components/PaymentConfirmation';
---

<BaseLayout title="Pedido confirmado — NonDecants" description="Tu pedido ha sido confirmado exitosamente" robots="noindex,nofollow">
  <div class="flex min-h-screen flex-col bg-bg-alt">
    <header class="border-b border-border bg-bg">
      <div class="mx-auto flex h-[66px] w-full max-w-[1480px] items-center justify-center px-4">
        <a href="/" aria-label="NönDecants — Inicio">
          <img src="/logonondecants.png" alt="NönDecants" width={543} height={127} class="h-7 w-auto" />
        </a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 pb-10 pt-6 sm:px-6 md:pb-16">
      <PaymentConfirmation client:load />
    </main>
  </div>
</BaseLayout>
