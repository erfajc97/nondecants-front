---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import Catalog from '@/app/features/catalog/Catalog';
import CatalogProductIndex from '@/app/features/catalog/components/CatalogProductIndex.astro';
import { fetchProducts } from '@/app/tanstack-queries/productsQuery';

const robots = Astro.url.search ? 'noindex,follow' : 'index,follow';
const indexed = await fetchProducts({ limit: 200, page: 1, bajoPedido: true });
---

<PublicLayout
  title="Perfumes por encargo en Ecuador | NonDecants"
  description="Frascos sellados que traemos en 13 a 17 días, con pago anticipado. Rarezas árabes, nicho y diseñador."
  canonical="/bajo-pedido"
  robots={robots}
>
  <div class="bg-bg min-h-screen">
    <div class="border-t border-border"></div>
    <Catalog client:load initialCategory="bajo-pedido" initialQuery={Astro.url.search} />
    <CatalogProductIndex products={indexed.content} title="Referencias bajo pedido" />
  </div>
</PublicLayout>
