---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import BannerCarouselIsland from '@/app/features/landing/components/sections-home/BannerCarouselIsland';
import Home from '@/app/features/landing/pages/home/Home';
import {
  absoluteImageUrl,
  homepageBannersJsonLd,
  websiteJsonLd,
} from '@/app/helpers/seoMeta';
import { fetchVisibleBanners } from '@/app/tanstack-queries/bannersQuery';

const banners = await fetchVisibleBanners();
const firstBannerImage = absoluteImageUrl(banners[0]?.imageUrl || banners[0]?.image);
---

<PublicLayout
  title="Perfumes originales y decants en Ecuador | NonDecants"
  description="Perfumes árabes, nicho y de diseñador 100 % originales. Pruébalos en decant. Envío nacional 24–72 h."
  ogImage={firstBannerImage ?? '/og-image.jpg'}
  jsonLd={[websiteJsonLd(), homepageBannersJsonLd(banners)]}
>
  <BannerCarouselIsland initialBanners={banners} client:load />
  <Home client:load />
</PublicLayout>
