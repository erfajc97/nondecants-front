---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import { fetchComboById } from '@/app/tanstack-queries/combosQuery';
import { comboSeoDescription } from '@/app/helpers/seoMeta';
import { comboShareImagePath } from '@/app/helpers/ogCard';
import ComboDetailIsland from '@/app/features/combos/components/ComboDetailIsland';

const { id } = Astro.params;
const combo = await fetchComboById(id!);

if (!combo) {
  return Astro.redirect('/catalogo/combos');
}
---

<PublicLayout
  title={`${combo.name} | NonDecants`}
  description={comboSeoDescription(combo)}
  shareTitle={combo.name}
  ogDescription={comboSeoDescription(combo)}
  ogImage={comboShareImagePath(combo.id)}
  canonical={`/combo/${combo.id}`}
>
  <div class="bg-bg min-h-screen">
    <div class="mx-auto max-w-[1480px] px-4 py-4 pb-12 md:px-[clamp(16px,3.4vw,52px)] md:pb-24">
      {/* Breadcrumb */}
      <nav class="mb-5 flex items-center gap-2 py-2 font-body text-[13px] text-text-muted">
        <a href="/" class="transition-colors hover:text-text">Inicio</a>
        <span>·</span>
        <a href="/catalogo/combos" class="transition-colors hover:text-text">Combos</a>
        <span>·</span>
        <span class="text-text">{combo.name}</span>
      </nav>

      <ComboDetailIsland combo={combo} client:load />
    </div>
  </div>
</PublicLayout>
