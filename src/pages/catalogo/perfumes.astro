---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import Catalog from '@/app/features/catalog/Catalog';
import CatalogProductIndex from '@/app/features/catalog/components/CatalogProductIndex.astro';
import { fetchProducts } from '@/app/tanstack-queries/productsQuery';

const robots = Astro.url.search ? 'noindex,follow' : 'index,follow';
const indexed = await fetchProducts({ limit: 200, page: 1 });
---

<PublicLayout
  title="Perfumes originales en Ecuador | NonDecants"
  description="Perfumes originales árabes, nicho y de diseñador. Decant o frasco sellado. Envío 24–72 h en Ecuador."
  canonical="/catalogo/perfumes"
  robots={robots}
>
  <div class="bg-bg min-h-screen">
    <div class="border-t border-border"></div>
    <Catalog client:load initialQuery={Astro.url.search} />
    <CatalogProductIndex products={indexed.content} title="Todas las fragancias" />
  </div>
</PublicLayout>
