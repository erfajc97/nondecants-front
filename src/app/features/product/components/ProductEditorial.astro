---
import type { Product } from '@/app/types/global.types';
import { getEditorialFlags } from '../editorialFlags';
import '../product-detail.css';

/**
 * Bloques editoriales de la ficha, en el orden del prototipo:
 *   firma → notas (perfil olfativo + carácter/ocasión/longevidad/proyección)
 *   → descripción → autenticidad.
 * Cada `part` se omite si el producto no trae datos para él.
 */
interface Props {
  product: Product;
  part: 'firma' | 'notas' | 'descripcion' | 'autenticidad';
}

const { product, part } = Astro.props;
const flags = getEditorialFlags(product);

const sections = product.scentSections ?? [];
const mood = product.mood ?? [];
const occasion = product.occasion ?? [];
const longevity = product.longevity;
const projectionScore = product.projectionScore;
const benefits = product.benefits ?? [];

const SEC = 'pdp-anchor border-b border-border py-[clamp(36px,5vw,64px)]';
const WRAP = 'mx-auto max-w-[1480px] px-[max(16px,3.4vw)]';
const H2 = 'mb-[22px] mt-2 font-display text-[clamp(30px,3.2vw,44px)] font-normal leading-none text-text';

const pad = (n: number) => String(n).padStart(2, '0');

// Etiquetas del prototipo para el puntaje 0-10.
const LON = ['', 'Fugaz', 'Fugaz', 'Corta', 'Moderada', 'Moderada', 'Buena', 'Larga', 'Larga', 'Muy larga', 'Eterna'];
const PRJ = ['', 'Íntima', 'Íntima', 'Cercana', 'Cercana', 'Moderada', 'Moderada', 'Notoria', 'Fuerte', 'Muy fuerte', 'Llena el cuarto'];
const clamp10 = (v: number) => Math.max(0, Math.min(10, Math.round(v)));

// Etapas de la evolución: solo se rotulan si son las 3 clásicas.
const STG = [
  ['Salida', '0 – 15 min'],
  ['Corazón', '15 min – 3 h'],
  ['Fondo', '3 h en adelante'],
];
const allNotes = sections.flatMap((s) => s.notes ?? []);
const gradStops = allNotes.map((n) => n.color).filter(Boolean);
const grad =
  gradStops.length > 1
    ? gradStops.map((c, i) => `${c} ${Math.round((i / (gradStops.length - 1)) * 100)}%`).join(',')
    : `${gradStops[0] ?? 'transparent'},${gradStops[0] ?? 'transparent'}`;
const showEvo = sections.length === 3 && gradStops.length > 0;
let noteIdx = 0;

const sigParagraphs = (product.signatureDescription ?? '')
  .split(/\n+/)
  .map((t) => t.trim())
  .filter(Boolean);
const sigDots = allNotes.slice(0, 6);
// Imagen de la firma; si no hay, la foto ambientada del producto (2.ª foto o la principal).
const sigImage =
  product.signatureImageUrl ||
  (product.images && product.images.length > 1 ? product.images[1] : undefined) ||
  product.images?.[0] ||
  product.image ||
  '';

// Promesa de autenticidad — quemada en todos los productos
const TRUST = [
  {
    title: 'El frasco original',
    desc: 'Solo trabajamos con perfumes reales, de boutiques oficiales y distribuidores autorizados. Cada frasco es verificado por nosotros.',
  },
  {
    title: 'El proceso',
    desc: 'Cada decant se extrae de una botella 100% auténtica y se decanta con su propio instrumento, para que ningún aroma se mezcle con otro.',
  },
  {
    title: 'La etiqueta',
    desc: 'Cada decant lleva su etiqueta personalizada con el sello de la casa.',
  },
];

const stageCols = sections.length >= 3 ? 'md:grid-cols-3' : sections.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-1';
const ticks = Array.from({ length: 10 }, (_, i) => {
  const a = ((135 + i * 30) * Math.PI) / 180;
  return { i, x: (60 + 50 * Math.cos(a)).toFixed(1), y: (60 + 50 * Math.sin(a)).toFixed(1) };
});
const lon = longevity != null ? clamp10(longevity) : null;
const prj = projectionScore != null ? clamp10(projectionScore) : null;
const prjRings = prj != null ? Math.max(1, Math.round(prj / 2)) : 0;
---

{/* ── La firma ── */}
{part === 'firma' && flags.hasSignature && (
  <section id="p-firma" data-rv class={SEC}>
    <div class:list={[WRAP, 'grid gap-6 md:gap-[clamp(24px,5vw,80px)]', sigImage ? 'items-center md:grid-cols-2' : 'md:grid-cols-1']}>
      {sigImage && (
        <figure class="pdp-sig relative m-0 aspect-square overflow-hidden rounded-md bg-text md:order-1">
          <img src={sigImage} alt={product.signatureTitle ?? product.name} class:list={['h-full w-full', product.signatureImageUrl ? 'object-cover' : 'object-contain p-[8%]']} loading="lazy" />
          {sigDots.length > 0 && (
            <figcaption class="absolute bottom-3.5 left-3.5 flex gap-1.5">
              {sigDots.map((n, i) => (
                <i class="block h-3.5 w-3.5 rounded-full shadow-[0_0_0_2px_rgba(255,255,255,0.85)]" style={`background:${n.color};--i:${i}`}></i>
              ))}
            </figcaption>
          )}
        </figure>
      )}
      <div class:list={[sigImage ? 'md:order-2' : '']}>
        <span class="eyebrow k">La firma</span>
        {(product.signatureTitle || product.name) && (
          <h2 class="mb-[18px] mt-2.5 font-display text-[clamp(34px,4.4vw,62px)] font-normal leading-none tracking-[-0.02em] text-text">
            {product.signatureTitle || product.name}
          </h2>
        )}
        {sigParagraphs.map((t, i) => (
          <p class:list={['max-w-[58ch] font-body text-[clamp(17px,1.3vw,19px)] leading-[1.65]', i === 0 ? 'text-text' : 'mt-3.5 text-text-soft']}>{t}</p>
        ))}
      </div>
    </div>
  </section>
)}

{/* ── Notas y carácter ── */}
{part === 'notas' && flags.hasNotes && (
  <section id="p-notas" data-rv class={SEC}>
    <div class={WRAP}>
      <span class="eyebrow k">Perfil olfativo</span>
      <h2 class={H2}>{product.scentProfileTitle || 'Cómo evoluciona en tu piel'}</h2>

      {flags.hasScent && (
        <div style={`--grad:linear-gradient(90deg,${grad})`}>
          {showEvo && (
            <div class="pdp-evo-bar relative mb-4 mt-1.5 hidden h-14 md:block" aria-hidden="true">
              <i></i>
              {STG.map((s, i) => (
                <span class="absolute top-[18px] border-l border-border pl-2.5 font-body text-[12.5px] leading-[1.3] text-text-muted" style={`left:${i * 33.33}%`}>
                  <b class="block text-[13px] font-semibold text-text">{s[0]}</b>
                  {s[1]}
                </span>
              ))}
            </div>
          )}
          <div class:list={['grid gap-3.5', stageCols]}>
            {sections.map((sec, i) => {
              const cs = (sec.notes ?? []).map((n) => n.color);
              return (
                <div class="pdp-stg relative overflow-hidden rounded-md border border-border bg-white p-[22px]" style={`--a:${cs[0] ?? 'transparent'};--b:${cs[1] ?? cs[0] ?? 'transparent'};--c:${cs[2] ?? cs[0] ?? 'transparent'}`}>
                  <div class="pdp-aura" aria-hidden="true"><i></i><i></i><i></i></div>
                  <span class="font-display text-[15px] text-accent-hover">{pad(i + 1)}</span>
                  <h3 class="mt-0.5 font-body text-sm font-semibold text-text">{sec.title}</h3>
                  {sec.notes?.length > 0 && (
                    <ul class="m-0 mt-3.5 flex list-none flex-wrap gap-2 p-0">
                      {sec.notes.map((n) => (
                        <li class="pdp-nchip inline-flex h-9 cursor-default items-center gap-2 rounded-full pl-2 pr-3.5 font-display text-[17px] text-text" style={`--c:${n.color};--i:${noteIdx++}`}>
                          <i></i>{n.name}
                        </li>
                      ))}
                    </ul>
                  )}
                  {sec.description && (
                    <p class="mt-3.5 whitespace-pre-line font-body text-sm leading-[1.55] text-text-soft">{sec.description}</p>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {flags.hasIdentity && (
        <div class="mt-3.5 grid grid-cols-2 gap-3.5 md:grid-cols-4">
          {mood.length > 0 && (
            <div class="pdp-lift rounded border border-border p-[18px]">
              <div class="font-body text-[13px] text-text-muted">Carácter</div>
              <div class="mt-1.5 font-body text-[15px] leading-[1.4] text-text">{mood.join(' · ')}</div>
            </div>
          )}
          {occasion.length > 0 && (
            <div class="pdp-lift rounded border border-border p-[18px]">
              <div class="font-body text-[13px] text-text-muted">Ocasión</div>
              <div class="mt-1.5 font-body text-[15px] leading-[1.4] text-text">{occasion.join(' · ')}</div>
            </div>
          )}
          {lon != null && (
            <div class="pdp-gauge pdp-g-lon flex flex-col items-start gap-2.5 rounded border border-border p-[18px] md:flex-row md:items-center md:gap-[18px]" style={`--v:${lon}`}>
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="trk" cx="60" cy="60" r="50" pathLength="100" />
                <circle class="val" cx="60" cy="60" r="50" pathLength="100" />
                {ticks.map((t) => (
                  <circle class:list={['tk', t.i < lon && 'on']} cx={t.x} cy={t.y} r="2.2" style={`--i:${t.i}`} />
                ))}
                <g class="pdp-hg" transform="translate(60 60)">
                  <path d="M-9-16h18M-9 16h18M-7-16c0 9 7 9 7 16s-7 7-7 16M7-16c0 9-7 9-7 16s7 7 7 16" />
                  <path class="sand" d="M-5-10h10l-5 7z" />
                  <path class="sand2" d="M-6 15h12l-6-6z" />
                </g>
              </svg>
              <div class="grid gap-0.5">
                <span class="font-body text-[13px] text-text-muted">Longevidad</span>
                <span class="mt-1 font-display leading-none"><b class="text-[34px] font-normal md:text-[44px]" data-count={lon}>{lon}</b><small class="ml-[3px] font-body text-[13px] text-text-muted">/10</small></span>
                <span class="font-body text-[13.5px] font-semibold text-accent-hover">{LON[lon] ?? ''}</span>
              </div>
            </div>
          )}
          {prj != null && (
            <div class="pdp-gauge pdp-g-pr flex flex-col items-start gap-2.5 rounded border border-border p-[18px] md:flex-row md:items-center md:gap-[18px]" style={`--v:${prj}`}>
              <svg viewBox="0 0 120 120" aria-hidden="true">
                {[1, 2, 3, 4, 5].map((i) => (
                  <circle class:list={['ring', i <= prjRings && 'on']} cx="60" cy="60" r={i * 10.5} style={`--i:${i}`} />
                ))}
                {[0, 1, 2].map((w) => (
                  <circle class="wave" cx="60" cy="60" r={prjRings * 10.5} style={`--w:${w}`} />
                ))}
                <circle class="core" cx="60" cy="60" r="5" />
              </svg>
              <div class="grid gap-0.5">
                <span class="font-body text-[13px] text-text-muted">Proyección</span>
                <span class="mt-1 font-display leading-none"><b class="text-[34px] font-normal md:text-[44px]" data-count={prj}>{prj}</b><small class="ml-[3px] font-body text-[13px] text-text-muted">/10</small></span>
                <span class="font-body text-[13.5px] font-semibold text-accent-hover">{PRJ[prj] ?? ''}</span>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </section>
)}

{/* ── Descripción + por qué gusta ── */}
{part === 'descripcion' && flags.hasDetail && (
  <section id="p-det" data-rv class={SEC}>
    <div class:list={[WRAP, 'grid gap-6 md:gap-[clamp(24px,4vw,64px)]', benefits.length > 0 && product.detailDescription ? 'md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]' : '']}>
      {product.detailDescription && (
        <div>
          <span class="eyebrow k">Descripción</span>
          <h2 class={H2}>Todo sobre {product.name}</h2>
          <p class="max-w-[64ch] whitespace-pre-line font-body text-base leading-[1.7] text-text-soft">{product.detailDescription}</p>
        </div>
      )}
      {benefits.length > 0 && (
        <div>
          <span class="eyebrow k">Por qué gusta</span>
          <ul class="m-0 mt-[18px] grid list-none gap-2 p-0">
            {benefits.map((b) => (
              <li class="flex items-center gap-2.5 border-b border-border pb-2 font-body text-[15px] before:text-accent before:content-['✦']">{b}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

{/* ── Promesa de autenticidad (quemado) ── */}
{part === 'autenticidad' && (
  <section id="p-auth" data-rv class={SEC}>
    <div class={WRAP}>
      <span class="eyebrow k">Promesa de autenticidad</span>
      <h2 class={H2}>Cada gota, verificada.</h2>
      <div class="grid gap-3.5 md:grid-cols-3">
        {TRUST.map((t, i) => (
          <div class="pdp-lift rounded bg-bg-alt p-[22px]">
            <span class="font-display text-[15px] text-accent-hover">{pad(i + 1)}</span>
            <h3 class="mt-1.5 font-display text-2xl font-normal text-text">{t.title}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-text-muted">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
