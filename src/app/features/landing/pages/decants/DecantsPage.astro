---
import DecantsCategoryExits from '@/app/features/landing/components/decants/DecantsCategoryExits';

interface Props {
  faq: { question: string; answer: string }[];
}

const { faq } = Astro.props;

const SIZES = [
  {
    ml: '3 ml',
    sprays: '≈ 33',
    use: 'Una semana a diario',
    for: 'Decidir si te gusta y cómo evoluciona en tu piel',
  },
  {
    ml: '5 ml',
    sprays: '≈ 55',
    use: 'Dos semanas',
    for: 'Llevarlo de viaje o rotar entre varios',
  },
  {
    ml: '10 ml',
    sprays: '≈ 110',
    use: 'Un mes',
    for: 'Usarlo de verdad sin comprometerte con el frasco',
  },
];

const COMPARE = [
  { name: 'Lattafa Khamrah', try: '$4,15', miss: '$72,99' },
  { name: 'Xerjoff Naxos', try: '$11,50', miss: '$284,99' },
  { name: 'Parfums de Marly Layton', try: '$11,75', miss: '$294,99' },
];
---

<div class="bg-bg">
  <div class="px-[max(16px,3.4vw)] pt-5">
    <nav class="font-body text-[11px] tracking-[0.04em] text-text-muted">
      <a href="/" class="transition-colors hover:text-text">Inicio</a>
      <span class="mx-1.5 opacity-50">·</span>
      <span class="text-text">Decants</span>
    </nav>
  </div>

  <section class="border-b border-border px-[max(16px,3.4vw)] py-10 md:py-14">
    <p class="eyebrow k">Nuestra especialidad</p>
    <h1 class="mt-2 max-w-[22ch] font-display text-[clamp(40px,5vw,64px)] font-normal leading-[0.98] tracking-[-0.025em] text-balance text-text">
      Decants de perfumes originales en Ecuador
    </h1>
    <p class="mt-3 max-w-[52ch] font-body text-[15.5px] leading-relaxed text-text-soft">
      3, 5 o 10 ml de la misma botella original · desde $3,75
    </p>
  </section>

  <section class="mx-auto max-w-[780px] px-[max(16px,3.4vw)] py-8 md:py-10">
    <p class="font-body text-[17px] leading-relaxed text-text-soft">
      Un decant es una porción del perfume original, trasvasada de la misma botella que vendemos sellada a un
      atomizador de 3, 5 o 10&nbsp;ml. No es una imitación ni una versión «inspirada en»: es literalmente el mismo
      líquido en un frasco más pequeño.
    </p>
    <p class="mt-4 font-body text-[17px] leading-relaxed text-text-soft">
      Existe por una razón simple: nadie debería pagar $285 para descubrir que un perfume no era para él.
    </p>
  </section>

  <section class="px-[max(16px,3.4vw)] pb-12 md:pb-14">
    <h2 class="font-display text-[clamp(28px,3.2vw,46px)] font-normal leading-none tracking-[-0.02em] text-text">3, 5 o 10 ml: cuál elegir</h2>
    <p class="mt-1.5 font-body text-[14.5px] text-text-muted">
      Las pulsaciones son aproximadas y varían según el atomizador y el perfume.
    </p>

    <div class="mt-5 hidden overflow-hidden rounded-[4px] border border-border bg-surface md:block">
      <div class="grid grid-cols-[.75fr_.85fr_1.05fr_1.6fr] border-b border-border bg-bg-alt">
        <div class="eyebrow px-[18px] py-3">Tamaño</div>
        <div class="eyebrow px-[18px] py-3">Pulsaciones</div>
        <div class="eyebrow px-[18px] py-3">Uso real</div>
        <div class="eyebrow px-[18px] py-3">Para qué sirve</div>
      </div>
      {SIZES.map((row, i) => (
        <div
          class:list={[
            'grid grid-cols-[.75fr_.85fr_1.05fr_1.6fr] items-center',
            i < SIZES.length - 1 ? 'border-b border-border-soft' : '',
            i === SIZES.length - 1 ? 'bg-surface-raised' : '',
          ]}
        >
          <div class="px-[18px] py-4 font-display text-2xl text-text">{row.ml}</div>
          <div class="px-[18px] py-4 font-body text-sm text-text-soft">{row.sprays}</div>
          <div class="px-[18px] py-4 font-body text-sm text-text-soft">{row.use}</div>
          <div class="px-[18px] py-4 font-body text-sm text-text-soft">{row.for}</div>
        </div>
      ))}
    </div>

    <div class="mt-5 flex flex-col gap-3 md:hidden">
      {SIZES.map((row) => (
        <article class="rounded-[4px] border border-border bg-surface px-5 py-5">
          <p class="font-display text-2xl text-text">{row.ml}</p>
          <p class="mt-2 font-body text-sm text-text-soft">{row.sprays} pulsaciones · {row.use}</p>
          <p class="mt-1 font-body text-sm text-text-soft">{row.for}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-border bg-bg-alt px-[max(16px,3.4vw)] py-12 md:py-14">
    <h2 class="font-display text-[clamp(28px,3.2vw,46px)] font-normal leading-none tracking-[-0.02em] text-text">
      Lo que cuesta probar, y lo que cuesta equivocarte
    </h2>
    <p class="mt-1.5 max-w-[70ch] font-body text-[14.5px] text-text-muted">
      Precios reales de nuestro catálogo.
    </p>

    <div class="mt-6 grid items-start gap-10 md:grid-cols-[1.15fr_.85fr] md:gap-11">
      <div class="overflow-hidden rounded-[4px] border border-border bg-surface">
        <div class="grid grid-cols-[1.5fr_.8fr_.9fr] border-b border-border bg-bg-alt">
          <div class="eyebrow px-[18px] py-2.5">Perfume</div>
          <div class="eyebrow px-[18px] py-2.5">Probarlo</div>
          <div class="eyebrow px-[18px] py-2.5">Equivocarte</div>
        </div>
        {COMPARE.map((row, i) => (
          <div
            class:list={[
              'grid grid-cols-[1.5fr_.8fr_.9fr] items-center',
              i < COMPARE.length - 1 ? 'border-b border-border-soft' : '',
            ]}
          >
            <div class="px-[18px] py-3.5 font-body text-sm text-text">{row.name}</div>
            <div class="px-[18px] py-3.5 font-body text-sm font-semibold text-success">{row.try}</div>
            <div class="px-[18px] py-3.5 font-body text-sm text-text-soft">{row.miss}</div>
          </div>
        ))}
      </div>
      <div>
        <p class="font-display text-5xl font-normal leading-none text-accent-hover md:text-[64px]">14</p>
        <p class="mt-2.5 font-body text-[15px] leading-relaxed text-text-soft">
          fragancias árabes distintas puedes probar con <strong class="font-semibold text-text">$60</strong> en
          decants de 3&nbsp;ml.
        </p>
        <p class="mt-2 font-body text-[15px] leading-relaxed text-text-soft">
          Con esos mismos $60 no llegas ni a un cuarto de un frasco nicho.
        </p>
      </div>
    </div>
  </section>

  <section class="px-[max(16px,3.4vw)] py-12 md:py-14">
    <h2 class="font-display text-[clamp(28px,3.2vw,46px)] font-normal leading-none tracking-[-0.02em] text-text">
      Cuándo <em class="not-italic text-accent-hover">no</em> te conviene un decant
    </h2>
    <p class="mt-3 max-w-[72ch] font-body text-[15px] leading-relaxed text-text-soft">
      Por mililitro, el frasco siempre sale más barato. El decant no es para ahorrar: es para no equivocarte.
      Si ya sabes que un perfume es tuyo, compra el frasco — y nosotros te lo decimos aunque nos convenga lo otro.
    </p>
    <div class="mt-6 max-w-[640px] overflow-hidden rounded-[4px] border border-border bg-surface">
      <div class="grid grid-cols-4 border-b border-border bg-bg-alt">
        <div class="eyebrow px-3 py-2.5 sm:px-[18px]">Lattafa Khamrah</div>
        <div class="eyebrow px-3 py-2.5 sm:px-[18px]">3 ml</div>
        <div class="eyebrow px-3 py-2.5 sm:px-[18px]">10 ml</div>
        <div class="eyebrow px-3 py-2.5 sm:px-[18px]">Frasco</div>
      </div>
      <div class="grid grid-cols-4 items-center">
        <div class="px-3 py-3.5 font-body text-[13px] text-text-muted sm:px-[18px]">Precio por ml</div>
        <div class="px-3 py-3.5 font-body text-sm text-text sm:px-[18px]">$1,38</div>
        <div class="px-3 py-3.5 font-body text-sm text-text sm:px-[18px]">$1,02</div>
        <div class="px-3 py-3.5 font-body text-sm font-semibold text-success sm:px-[18px]">$0,73</div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-bg-alt px-[max(16px,3.4vw)] py-10 md:py-12">
    <h2 class="font-display text-[clamp(28px,3.2vw,46px)] font-normal leading-none tracking-[-0.02em] text-text">Cuánto dura y cómo guardarlo</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-7">
      <article class="rounded-[4px] border border-border bg-surface px-6 py-6">
        <h3 class="font-display text-xl font-normal text-text">Lejos de la luz y del calor</h3>
        <p class="mt-2 font-body text-[13.5px] leading-relaxed text-text-soft">
          Un cajón vale más que el estante del baño. El vapor de la ducha y el sol directo son lo que de verdad degrada un perfume.
        </p>
      </article>
      <article class="rounded-[4px] border border-border bg-surface px-6 py-6">
        <h3 class="font-display text-xl font-normal text-text">Años, no meses</h3>
        <p class="mt-2 font-body text-[13.5px] leading-relaxed text-text-soft">
          Bien guardado, un decant aguanta perfectamente el tiempo que tardas en terminarlo. Los cítricos son los primeros en perder filo.
        </p>
      </article>
      <article class="rounded-[4px] border border-border bg-surface px-6 py-6">
        <h3 class="font-display text-xl font-normal text-text">No lo trasvases otra vez</h3>
        <p class="mt-2 font-body text-[13.5px] leading-relaxed text-text-soft">
          Cada trasvase mete aire. El atomizador con el que te llega es el que mejor lo conserva.
        </p>
      </article>
    </div>
  </section>

  <section class="px-[max(16px,3.4vw)] py-12 md:py-14">
    <h2 class="font-display text-[clamp(28px,3.2vw,46px)] font-normal leading-none tracking-[-0.02em] text-text">Preguntas frecuentes</h2>
    <div class="mt-5 max-w-[840px] border-t border-border">
      {faq.map((item) => (
        <details class="group border-b border-border py-3">
          <summary class="relative cursor-pointer list-none py-1 pr-9 font-body text-[17px] font-semibold text-text after:absolute after:right-1 after:top-0 after:font-display after:text-[28px] after:font-normal after:text-accent-hover after:transition-transform after:duration-300 after:content-['+'] group-open:after:rotate-45 [&::-webkit-details-marker]:hidden">
            {item.question}
          </summary>
          <p class="mt-1.5 font-body text-[14.5px] leading-relaxed text-text-soft">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <DecantsCategoryExits client:load />
</div>
