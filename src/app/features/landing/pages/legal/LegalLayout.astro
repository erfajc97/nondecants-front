---
interface Props {
  eyebrow?: string;
  title: string;
  updated?: string;
  intro?: string;
}
const { eyebrow = 'Legal', title, updated, intro } = Astro.props;
---

<section class="bg-bg">
  <div class="mx-auto max-w-[820px] px-[max(16px,3.4vw)] py-12 md:py-24">
    <span class="eyebrow k">{eyebrow}</span>
    <h1 class="mt-2 font-heading text-[clamp(40px,5vw,64px)] font-normal leading-[0.98] tracking-[-0.025em] text-balance text-text">
      {title}
    </h1>
    {updated && (
      <p class="mt-5 font-body text-[13px] text-text-muted">
        Última actualización: {updated}
      </p>
    )}
    {intro && (
      <p class="mt-8 max-w-[640px] font-body text-[15px] leading-relaxed text-text-soft">
        {intro}
      </p>
    )}

    <div class="mt-12 h-px bg-border"></div>

    <article class="legal-prose mt-12">
      <slot />
    </article>
  </div>
</section>

<style>
  .legal-prose :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-text);
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.005em;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(h3) {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose :global(p) {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-soft);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .legal-prose :global(ul) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
    list-style: none;
  }
  .legal-prose :global(li) {
    position: relative;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    margin-bottom: 0.4rem;
    padding-left: 0.25rem;
  }
  .legal-prose :global(li)::before {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 0.7em;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: var(--color-accent);
  }
  .legal-prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .legal-prose :global(a) {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(a:hover) {
    color: var(--color-text);
  }
  .legal-prose :global(.legal-contact) {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .legal-prose :global(.legal-contact p) {
    margin-bottom: 0.35rem;
  }
</style>
