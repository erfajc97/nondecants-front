---
import { PAYMENT_LOGOS } from '@/app/components/paymentLogos';
import { FOOTER_LINKS_COL1 } from '../../data';

// Cuentas reales de la casa. Sin parámetros de rastreo: así el enlace es
// indexable y no arrastra la sesión de quien lo compartió.
const SOCIAL = [
  { label: 'Instagram', href: 'https://www.instagram.com/nondecants' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@nondecants_' },
];

const WHATSAPP_URL = 'https://wa.me/593992305463';

// Catálogo compartido: mismos logos y alturas que ficha de producto, carrito y combos.
const PAYMENT_ICONS = PAYMENT_LOGOS;

const HELP_LINKS = [
  { href: '/faq', label: 'Preguntas frecuentes' },
  { href: '/rastrear', label: 'Rastrear tu pedido' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/privacidad', label: 'Privacidad' },
];

const CONTACT = ['+593 99 230 5463', 'contacto@nondecants.com'];

const year = new Date().getFullYear();
---

<footer class="bg-text text-bg/80">
  <!-- pb-28 en mobile: la tab bar es fixed (~65px + safe area) y tapaba la última fila. -->
  <div class="mx-auto max-w-[1480px] px-[max(16px,3.4vw)] pb-28 pt-11 md:px-[min(52px,3.4vw)] md:pb-7 md:pt-[72px]">
    <div class="grid grid-cols-2 gap-7 md:grid-cols-[2fr_1fr_1fr_1fr]">

      <!-- Marca -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" aria-label="NonDecants — Inicio" class="inline-block">
          <img src="/logonondecants.png" alt="NonDecants" width={543} height={127} class="h-[30px] w-auto invert brightness-110" />
        </a>
        <p class="mt-4 font-display text-[21px] leading-snug text-bg">Primero lo pruebas. Después decides.</p>
        <p class="mt-3 max-w-[38ch] font-body text-sm leading-relaxed text-bg/60">
          Perfumes originales de diseñador, nicho y árabes, en decant y en frasco sellado. Guayaquil, Ecuador.
        </p>
      </div>

      <!-- Tienda -->
      <div>
        <h4 class="mb-3 font-body text-[13px] font-semibold text-accent">Tienda</h4>
        <ul class="font-body text-sm">
          {FOOTER_LINKS_COL1.map((l) => (
            <li class="py-[3px]"><a href={l.href} class="transition-colors hover:text-bg">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Ayuda -->
      <div>
        <h4 class="mb-3 font-body text-[13px] font-semibold text-accent">Ayuda</h4>
        <ul class="font-body text-sm">
          {HELP_LINKS.map((l) => (
            <li class="py-[3px]"><a href={l.href} class="transition-colors hover:text-bg">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contacto: el teléfono abre el chat, el correo abre el cliente de mail -->
      <div class="col-span-2 md:col-span-1">
        <h4 class="mb-3 font-body text-[13px] font-semibold text-accent">Contacto</h4>
        <ul class="font-body text-sm">
          <li class="py-[3px]">
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 transition-colors hover:text-bg"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a9.94 9.94 0 0 0-8.5 15.2L2 22l4.95-1.45A9.94 9.94 0 1 0 12 2Zm0 18.1a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-2.94.86.86-2.86-.2-.3A8.15 8.15 0 1 1 12 20.1Zm4.5-6.1c-.25-.13-1.45-.72-1.68-.8-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.4 7.4 0 0 1-1.36-1.69c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.13.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z" />
              </svg>
              {CONTACT[0]}
            </a>
          </li>
          <li class="py-[3px]">
            <a href={`mailto:${CONTACT[1]}`} class="transition-colors hover:text-bg">{CONTACT[1]}</a>
          </li>
          {SOCIAL.map((s) => (
            <li class="py-[3px]">
              <a href={s.href} target="_blank" rel="me noopener" class="transition-colors hover:text-bg">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Medios de pago: los logos oficiales traen fondo propio, van sobre una
         franja clara para que se lean sobre el negro. -->
    <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2.5 rounded-[4px] bg-bg px-4 py-3 md:gap-x-4 md:self-start md:inline-flex">
      {PAYMENT_ICONS.map((icon) => (
        <img
          src={icon.src}
          alt={icon.alt}
          title={icon.alt}
          loading="lazy"
          class:list={['w-auto object-contain', icon.cls]}
        />
      ))}
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-4 border-t border-bg/15 pt-5 font-body text-[12.5px] text-bg/55 md:flex-row md:items-center md:flex-wrap">
      <span>© {year} NonDecants · Ecuador</span>
      <b class="font-semibold tracking-[0.12em] text-accent" aria-hidden="true">✦ ORIGINAL O NADA ✦</b>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/terminos" class="transition-colors hover:text-bg">Términos</a>
        <a href="/privacidad" class="transition-colors hover:text-bg">Privacidad</a>
        <a href="/cookies" class="transition-colors hover:text-bg">Cookies</a>
        <a href="/faq" class="transition-colors hover:text-bg">FAQ</a>
      </div>
    </div>
  </div>
</footer>

<!-- BEGIN MerchantWidget Code — snippet oficial de Merchant Center -->
<script is:inline id="merchantWidgetScript" src="https://www.gstatic.com/shopping/merchant/merchantwidget.js" defer></script>
<script is:inline>
  function startNondecantsMerchantWidget() {
    if (!window.merchantwidget) return;
    merchantwidget.start({
      merchant_id: 5847763007,
      position: 'LEFT_BOTTOM',
      bottomMargin: 24,
      mobileBottomMargin: 88,
    });
  }
  var merchantWidgetScript = document.getElementById('merchantWidgetScript');
  if (merchantWidgetScript) {
    if (window.merchantwidget) {
      startNondecantsMerchantWidget();
    } else {
      merchantWidgetScript.addEventListener('load', startNondecantsMerchantWidget);
    }
  }
</script>
<!-- END MerchantWidget Code -->
