---
import FeatureItem from '../FeatureItem.astro';
import BoxIcon from '@/assets/svg/BoxIcon';
import HandsIcon from '@/assets/svg/HandsIcon';
import LockIcon from '@/assets/svg/LockIcon';
import TruckIcon from '@/assets/svg/TruckIcon';
import WalletIcon from '@/assets/svg/WalletIcon';

const FEATURES = [
  { Icon: WalletIcon, label: 'Pago 100%\nSeguro' },
  { Icon: LockIcon,   label: 'Autenticidad de\nproductos' },
  { Icon: TruckIcon,  label: 'Envíos inmediatos\nServientrega' },
  { Icon: HandsIcon,  label: 'Bajo\npedido' },
  { Icon: BoxIcon,    label: 'Garantía de\ndevolución 7 días' },
] as const;
---

<!-- Desktop only: integrated into first landing section below, hidden on mobile -->
<div class="hidden md:block max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 mb-2 relative z-10">
  <div class="overflow-hidden rounded-3xl border border-accent/30 bg-[url('/bg-black-feature.webp')] bg-cover bg-center shadow-lg">
    <div class="flex items-center justify-around gap-4 px-8 py-10 lg:px-12 lg:py-12">
      {FEATURES.map(({ Icon, label }, i) => (
        <>
          <FeatureItem Icon={Icon} label={label} />
          {i < FEATURES.length - 1 && (
            <div class="h-12 w-px bg-border" />
          )}
        </>
      ))}
    </div>
  </div>
</div>
