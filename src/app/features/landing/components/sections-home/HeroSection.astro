---
// Empty frontmatter — todo hardcoded
---

<section class="relative flex min-h-screen flex-col overflow-hidden -mt-16">

  {/* ── Imagen de fondo full-vh ── */}
  <img
    src="/home-1280.webp"
    srcset="/home-768.webp 768w, /home-1280.webp 1280w, /home-1920.webp 1920w"
    sizes="100vw"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover object-center"
    fetchpriority="high"
  />

  {/* ── Overlay gradiente: Black Carbón izquierda → transparente derecha ── */}
  <div class="absolute inset-0 bg-linear-to-r from-[--color-bg] via-[--color-bg]/80 to-[--color-bg]/25" />
  {/* Capa extra en móvil para legibilidad */}
  <div class="absolute inset-0 bg-[--color-bg]/50 lg:hidden" />

  {/* ── Contenido principal ── */}
  <div class="relative -top-14 lg:top-0 z-10 flex flex-1 items-start">
    <div class="mx-auto w-full max-w-8xl px-2 pt-48 pb-20 lg:px-28">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">

        {/* ── Columna izquierda ── */}
        <div class="flex flex-col gap-8">
          <div>
            <h1 class="font-heading text-[clamp(1.6rem,2vw,2.8rem)] font-normal uppercase leading-[0.96] tracking-[-0.02em] text-white">
              Única Experiencia
            </h1>
            <span class="mt-1 block font-body text-[clamp(3.5rem,8vw,7rem)] font-black italic leading-[0.96] tracking-[-0.02em] text-accent">
              Decants
            </span>
          </div>
        </div>

        {/* ── Columna derecha (solo desktop) ── */}
        <div class="hidden flex-col items-end gap-5 self-start lg:flex">
          <p class="max-w-88 text-right text-xl leading-relaxed text-white">
            Conoce nuestra experiencia en perfumes somos nondecants el mayor comercio en perfumes decants.
          </p>
        </div>

      </div>
    </div>
  </div>

</section>
