---
import { productUrl } from '@/app/helpers/productUrl';
import type { Product } from '@/app/types/global.types';

interface Props {
  products: Product[];
  title?: string;
}

const { products, title = 'Índice de fragancias' } = Astro.props;
---

{products.length > 0 && (
  <!-- Solo para buscadores y lectores de pantalla: enlaces a todas las fichas sin ocupar espacio visual. -->
  <nav class="sr-only" aria-label={title}>
    <h2 class="font-body text-[11px] font-semibold uppercase tracking-[0.12em] text-text-muted">{title}</h2>
    <ul class="mt-3 columns-1 gap-x-10 sm:columns-2 lg:columns-3">
      {products.map((product) => (
        <li class="break-inside-avoid py-0.5">
          <a
            href={productUrl(product)}
            class="font-body text-xs leading-snug text-text-muted transition-colors hover:text-text"
          >
            {product.marca?.name ? `${product.marca.name} · ` : ''}
            {product.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
