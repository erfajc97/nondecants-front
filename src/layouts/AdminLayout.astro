---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  section?: string;
}

const { title = 'Admin — NönDecants', section } = Astro.props;
---

<BaseLayout title={title}>
  <div class="flex min-h-dvh">
    <!-- Sidebar -->
    <aside class="w-64 shrink-0 bg-[--color-surface] border-r border-[--color-border] flex flex-col">
      <div class="p-6 border-b border-[--color-border]">
        <a href="/" class="font-heading text-xl text-[--color-accent] tracking-widest uppercase">
          NönDecants
        </a>
        <span class="block text-[--color-text-muted] text-xs mt-0.5">Panel Admin</span>
      </div>

      <nav class="flex-1 p-4 space-y-1">
        {[
          { href: '/admin/dashboard',   label: 'Dashboard' },
          { href: '/admin/productos',   label: 'Productos' },
          { href: '/admin/inventario',  label: 'Inventario' },
          { href: '/admin/ordenes',     label: 'Órdenes' },
          { href: '/admin/clientes',    label: 'Clientes' },
          { href: '/admin/finanzas',    label: 'Finanzas' },
        ].map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-2.5 rounded-[--radius-md] text-sm font-medium transition-colors
              ${section === item.label.toLowerCase()
                ? 'bg-[--color-accent] text-[--color-bg]'
                : 'text-[--color-text-muted] hover:text-[--color-text] hover:bg-[--color-surface-raised]'
              }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="p-4 border-t border-[--color-border]">
        <a
          href="/"
          class="block text-sm text-[--color-text-muted] hover:text-[--color-text] transition-colors"
        >
          ← Volver a la tienda
        </a>
      </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-h-dvh overflow-x-hidden">
      <header class="h-16 border-b border-[--color-border] bg-[--color-surface] flex items-center px-6">
        <h1 class="font-heading text-lg text-[--color-text] uppercase tracking-wider">
          {section ?? 'Dashboard'}
        </h1>
      </header>
      <main class="flex-1 p-6">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
