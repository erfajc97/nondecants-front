---
import '../styles/global.css';
import { SHARE_DESCRIPTION, SHARE_TITLE, SITE_ORIGIN } from '@/app/helpers/seoMeta';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import gloockLatin from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /**
   * Título de la tarjeta al compartir (WhatsApp, Linktree, etc.).
   * Si no viene, se usa el título SEO de la página.
   */
  shareTitle?: string;
  /** Description de Open Graph. Si no viene: home usa el copy de Linktree; el resto, `description`. */
  ogDescription?: string;
  /** Imagen de la vista previa al compartir. Ruta absoluta o URL completa. */
  ogImage?: string;
  robots?: string;
  /** Canonical override (path o URL). Si no viene, se arma con el pathname actual. */
  canonical?: string;
  ogType?: string;
  jsonLd?: unknown[];
}

const {
  title = 'NonDecants — Perfumes sellados, decants y nondecants',
  description = 'Compra perfumes sellados, decants y nondecants en Ecuador. Envíos a todo el país vía Servientrega.',
  shareTitle: shareTitleProp,
  ogDescription: ogDescriptionProp,
  ogImage = '/og-image.jpg',
  robots = 'index,follow',
  canonical: canonicalProp,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

// WhatsApp y varias apps renderizan la diéresis con una tipografía que no la
// trae y sale un caracter roto, así que la tarjeta al compartir dice
// "NonDecants" en texto plano. En la página el nombre sigue con ö.
const plainBrand = (text: string) => text.replace(/ö/g, 'o').replace(/Ö/g, 'O');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const shareTitle = plainBrand(
  shareTitleProp ?? (isHome ? SHARE_TITLE : title),
);
const ogDescription = plainBrand(
  ogDescriptionProp ?? (isHome ? SHARE_DESCRIPTION : description),
);
const site = Astro.site ?? SITE_ORIGIN;
const canonical = canonicalProp
  ? new URL(canonicalProp, site)
  : new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage, site);
const isRemoteImage = /^https?:\/\//i.test(ogImage);
const isOgJpeg = ogImage.includes('/og/');
if (!isRemoteImage) {
  // Linktree / Iframely cachean og:image por URL exacta. Sin `v=` siguen
  // sirviendo la foto vieja aunque el archivo en disco ya cambió.
  ogImageUrl.searchParams.set('v', '20260827');
}
const jsonLdPayload = jsonLd.filter(Boolean);
const ogUpdated = new Date().toISOString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="image_src" href={ogImageUrl.href} />

    <!-- Vista previa al compartir (WhatsApp, Linktree, Facebook, Telegram) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NonDecants" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:secure_url" content={ogImageUrl.href} />
    <meta property="og:image:url" content={ogImageUrl.href} />
    {(isOgJpeg || !isRemoteImage) && <meta property="og:image:type" content="image/jpeg" />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />
    <meta property="og:updated_time" content={ogUpdated} />

    <!-- Scrapers que ignoran Open Graph (algunos de Linktree / Iframely) -->
    <meta itemprop="name" content={shareTitle} />
    <meta itemprop="description" content={ogDescription} />
    <meta itemprop="image" content={ogImageUrl.href} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={shareTitle} />

    <!-- Google exige múltiplos de 48px. /favicon.ico es lo que piden Chrome y
         los resultados de búsqueda si el <link> falla o está cacheado. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=20260828" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=20260828" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=20260828" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png?v=20260828" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20260828" />

    <!-- Fuentes autohospedadas: sin CSS externo que bloquee el primer paint. -->
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={gloockLatin} as="font" type="font/woff2" crossorigin />
    {jsonLdPayload.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <!-- Sin AppProviders aquí: cada island gestiona su propio QueryClientProvider
         con el singleton de queryClient.ts. Zustand no necesita provider. -->
    <slot />
  </body>
</html>
